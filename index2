    border-radius: 30px;
    padding: 40px;
    color: white;
    box-shadow:
        0 0 30px rgba(255,215,0,0.15),
        0 0 60px rgba(255,105,180,0.08);
    animation: fadeIn 2s ease;
    overflow-y: auto;
    max-height: 90vh;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: scale(0.9);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

h1 {
    text-align: center;
    font-family: 'Cinzel', serif;
    font-size: 3rem;
    margin-bottom: 25px;
    color: #ffd700;
