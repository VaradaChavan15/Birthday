    animation: floatSparkle linear infinite;
}

@keyframes floatSparkle {
    0% {
        transform: translateY(100vh) scale(0.3);
        opacity: 0;
    }

    15% {
        opacity: 1;
    }

    50% {
        transform: translateY(50vh) translateX(40px) scale(1.3);
    }

    100% {
        transform: translateY(-20vh) translateX(-40px) scale(0.7);
        opacity: 0;
    }
